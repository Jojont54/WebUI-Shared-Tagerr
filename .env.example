PORT=3131
APP_URL=http://localhost:3131
APP_SECRET=remplacez-moi-par-une-valeur-aleatoire-d-au-moins-32-caracteres
TZ=Europe/Paris

# Modes disponibles : plex (par défaut) ou oidc.
AUTH_MODE=plex

# Requis uniquement avec AUTH_MODE=oidc.
# L’URI de redirection à déclarer côté fournisseur est :
# https://tagarr.example.com/api/auth/oidc/callback
OIDC_ISSUER=https://auth.example.com/application/o/tagarr/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ADMIN_GROUP=tagarr-admin
OIDC_SCOPES=openid profile email
